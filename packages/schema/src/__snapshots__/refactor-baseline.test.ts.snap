        },
      ],
      "extensions": {
        "vendor": {
          "enabled": true,
        },
      },
      "height": 8,
      "id": "unknown",
      "placement": {
        "mode": "fixed",
      },
      "print": "each",
      "props": {
        "custom": {
          "nested": [
            "keep",
            42,
            false,
          ],
        },
      },
      "renderCondition": {
        "groups": [
          {
            "conditions": [
              {
                "operator": {
                  "compare": "exists",
                },
                "source": {
                  "path": "customer/name",
                },
              },
            ],
          },
        ],
        "whenHidden": "reserve",
        "whenMatched": "show",
      },
      "repeat": {
        "scope": "every-output-page",
      },
      "type": "custom/uninstalled",
      "width": 20,
      "x": 2,
      "y": 3,
    },
    {
      "height": 24,
      "id": "table",
