      },
      "height": 12,
      "id": "chart",
      "props": {
        "categories": [
          "A",
        ],
        "customChartProp": true,
        "values": [
          3,
        ],
      },
      "type": "chart-bar",
      "width": 40,
      "x": 0,
      "y": 44,
    },
    {
      "height": 8,
      "id": "page-number",
      "props": {
        "format": "{current}/{total}",
      },
      "repeat": {
        "scope": "every-output-page",
      },
      "type": "page-number",
      "width": 20,
      "x": 60,
      "y": 50,
    },
  ],
  "extensions": {
    "vendor": {
      "data": [
        "opaque",
      ],
    },
  },
  "groups": [
    {
      "id": "group",
      "memberIds": [
        "unknown",
        "chart",
      ],
    },
  ],
  "guides": {
    "x": [
      2,
    ],
    "y": [
      3,
    ],
  },
