exports[`g0 persisted document baseline > characterizes existing codec losses without treating them as round-trip preservation 1`] = `
{
  "elements": [
    {
      "custom": {
        "nested": [
          "keep",
          42,
          false,
        ],
      },
      "height": 8,
      "id": "unknown",
      "renderCondition": {
        "groups": [
          {
            "conditions": [
              {
                "operator": {
                  "compare": "exists",
                },
                "source": {
                  "path": "customer/name",
                },
              },
            ],
          },
        ],
        "whenHidden": "reserve",
        "whenMatched": "show",
      },
      "type": "custom/uninstalled",
      "width": 20,
      "x": 2,
      "y": 3,
    },
    {
      "customTableProp": "keep",
      "extensions": {
        "table": {
          "kind": "data",
          "layout": {
            "borderAppearance": "all",
            "borderWidth": 0.2,
          },
          "topology": {
            "columns": [
              {
                "ratio": 1,
              },
            ],
            "rows": [
              {
                "cells": [
                  {
                    "content": {
                      "text": "Name",
                    },
                  },
                ],
                "height": 8,
                "role": "header",
              },
              {
                "cells": [
                  {
                    "binding": {
                      "fieldPath": "items/name",
                      "sourceId": "invoice",
                    },
                  },
                ],
                "height": 8,
                "role": "repeat-template",
              },
            ],
          },
        },
      },
      "height": 24,
      "id": "table",
      "type": "table-data",
      "width": 80,
      "x": 0,
      "y": 20,
    },
    {
      "categories": [
        "A",
      ],
      "customChartProp": true,
      "height": 12,
      "id": "chart",
      "type": "chart-bar",
      "values": [
        3,
      ],
      "width": 40,
      "x": 0,
      "y": 44,
    },
    {
      "format": "{current}/{total}",
      "height": 8,
      "id": "page-number",
      "type": "page-number",
      "width": 20,
      "x": 60,
      "y": 50,
    },
  ],
  "page": {
    "copies": 2,
    "height": 60,
    "pages": 2,
    "viewer": "fixed",
    "width": 80,
  },
  "unit": "mm",
  "x": [
    2,
  ],
  "y": [
    3,
  ],
}
`;

