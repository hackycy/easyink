          "fitness": [
            {
              "reason": "good for showing numeric correlation or distribution",
              "scenario": "analytics-report",
              "score": 0.9,
            },
            {
              "reason": "useful for compact numeric comparisons in printable layouts",
              "scenario": "dashboard",
              "score": 0.8,
            },
            {
              "reason": "tables are better for line-item detail",
              "scenario": "invoice-items",
              "score": 0.15,
            },
            {
              "reason": "too visual for narrow receipts",
              "scenario": "receipt-items",
              "score": 0.1,
            },
          ],
          "sizing": {
            "defaultSize": {
              "height": 90,
              "width": 160,
            },
            "growAxis": "none",
            "minHeight": 40,
            "minWidth": 50,
          },
