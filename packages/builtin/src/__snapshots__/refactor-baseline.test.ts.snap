      "aiDescriptor": {
        "binding": "data-contract",
        "description": "Scatter chart for showing correlation or distribution between two numeric fields from a material data contract target model.",
        "knowledge": {
          "bindingSpec": {
            "accepts": {
              "isArray": true,
              "minChildren": 2,
              "requiredChildFields": [
                "x",
                "y",
              ],
              "types": [
                "array",
              ],
            },
            "examples": [
              {
                "binding": {
                  "kind": "data-contract",
                  "mappings": {
                    "label": {
                      "select": {
                        "path": "measurements/batch",
                      },
                      "sourceId": "report",
                    },
                    "x": {
                      "select": {
                        "path": "measurements/temperature",
                      },
                      "sourceId": "report",
                    },
                    "y": {
                      "select": {
                        "path": "measurements/defectRate",
                      },
                      "sourceId": "report",
                    },
                  },
                  "relation": {
                    "kind": "auto",
                  },
                },
                "fieldStructure": {
                  "measurements": [
                    {
                      "batch": "string",
                      "defectRate": "number",
                      "temperature": "number",
                    },
                  ],
                },
                "scenario": "quality correlation",
              },
            ],
            "mode": "collection",
            "produces": {
              "fieldCount": "multiple",
              "kind": "multi-field",
              "pathPattern": "mappings.x.select.path + mappings.y.select.path",
            },
          },
          "category": "visualization",
          "composability": {
            "canBeChildOf": [
              "*",
