              ],
            },
            "examples": [
              {
                "binding": {
                  "kind": "data-contract",
                  "mappings": {
                    "category": {
                      "select": {
                        "path": "expenses/type",
                      },
                      "sourceId": "report",
                    },
                    "color": {
                      "select": {
                        "path": "expenses/color",
                      },
                      "sourceId": "report",
                    },
                    "value": {
                      "select": {
                        "path": "expenses/amount",
                      },
                      "sourceId": "report",
                    },
