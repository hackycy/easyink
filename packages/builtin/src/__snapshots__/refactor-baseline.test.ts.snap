      "aiDescriptor": {
        "binding": "multi",
        "description": "Receipt/detail row with mixed block and inline columns. Block columns take a full line; inline columns share a line by ratio, horizontal/vertical padding, and per-column alignment.",
        "knowledge": {
          "bindingSpec": {
            "accepts": {
              "isArray": true,
              "minChildren": 1,
              "types": [
                "array",
              ],
            },
            "examples": [
              {
                "binding": {
                  "fieldPath": "items",
                  "sourceId": "receipt",
                },
                "fieldStructure": {
                  "items": [
                    {
                      "amount": "number",
                      "name": "string",
                      "qty": "number",
                    },
                  ],
                },
                "scenario": "receipt item",
              },
            ],
            "mode": "collection",
            "produces": {
              "fieldCount": "dynamic",
              "kind": "collection-repeat",
              "pathPattern": "{collection}/{field}",
            },
          },
          "category": "data",
          "composability": {
            "canBeChildOf": [
              "*",
            ],
            "canContain": [],
            "exclusiveWith": [],
            "preferredCompanions": [
              "line",
              "text",
            ],
          },
          "fitness": [
            {
              "reason": "optimized for narrow receipt with mixed-width columns",
              "scenario": "receipt-items",
              "score": 0.95,
            },
            {
              "reason": "works but table-data is better for wide documents",
              "scenario": "invoice-items",
              "score": 0.5,
            },
            {
              "reason": "narrow list layout for mobile product cards",
              "scenario": "h5-landing",
              "score": 0.6,
