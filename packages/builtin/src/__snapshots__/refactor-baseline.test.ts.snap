              },
            ],
            "mode": "collection",
            "produces": {
              "fieldCount": "multiple",
              "kind": "multi-field",
              "pathPattern": "mappings.category.select.path + mappings.value.select.path + optional mappings.color.select.path",
            },
          },
          "category": "visualization",
          "composability": {
