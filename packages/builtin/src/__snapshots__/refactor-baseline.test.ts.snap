        "rotatable": true,
        "supportsAnimation": false,
        "supportsChildren": false,
        "supportsUnionDrop": false,
      },
      "category": "chart",
      "condition": {
        "hiddenEffects": [
          "remove",
          "reserve",
        ],
        "scope": "node",
      },
      "lazy": false,
