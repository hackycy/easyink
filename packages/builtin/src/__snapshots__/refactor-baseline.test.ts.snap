    {
      "aiDescriptor": {
        "binding": "data-contract",
        "description": "Simple bar chart for comparing numeric values from a material data contract target model: category field and value field mapped from source paths by relation resolver.",
        "knowledge": {
          "bindingSpec": {
            "accepts": {
              "isArray": true,
              "minChildren": 2,
              "requiredChildFields": [
                "category",
                "value",
              ],
              "types": [
                "array",
              ],
            },
            "examples": [
              {
                "binding": {
                  "kind": "data-contract",
                  "mappings": {
                    "category": {
                      "select": {
                        "path": "monthlySales/month",
                      },
                      "sourceId": "report",
                    },
                    "value": {
                      "select": {
                        "path": "monthlySales/revenue",
                      },
                      "sourceId": "report",
                    },
                  },
                  "relation": {
                    "kind": "auto",
                  },
                },
                "fieldStructure": {
                  "monthlySales": [
                    {
                      "month": "string",
                      "revenue": "number",
                    },
                  ],
                },
                "scenario": "monthly sales",
              },
            ],
            "mode": "collection",
            "produces": {
              "fieldCount": "multiple",
              "kind": "multi-field",
              "pathPattern": "mappings.category.select.path + mappings.value.select.path",
            },
          },
          "category": "visualization",
          "composability": {
            "canBeChildOf": [
              "*",
            ],
            "canContain": [],
            "exclusiveWith": [],
            "preferredCompanions": [
              "text",
            ],
          },
          "fitness": [
            {
              "reason": "good for compact categorical numeric comparisons",
              "scenario": "analytics-report",
              "score": 0.9,
            },
            {
              "reason": "simple static chart in printable layouts",
              "scenario": "dashboard",
              "score": 0.85,
            },
            {
              "reason": "tables are better for line-item detail",
              "scenario": "invoice-items",
              "score": 0.2,
            },
            {
              "reason": "too visual for narrow receipts",
              "scenario": "receipt-items",
              "score": 0.1,
            },
          ],
          "sizing": {
            "defaultSize": {
              "height": 90,
              "width": 160,
            },
            "growAxis": "none",
            "minHeight": 40,
            "minWidth": 50,
          },
        },
        "properties": [
          "barColor",
          "backgroundColor",
          "axisColor",
          "labelColor",
          "showValueLabels",
          "showGrid",
          "showXAxisLabel",
          "showYAxisLabel",
          "showXAxisLine",
          "showYAxisLine",
        ],
        "requiredProps": [
          "barColor",
        ],
        "schemaRules": [
          "Element type must be chart-bar.",
          "Props contain visual settings such as colors and simple display switches.",
          "Chart data should be described by binding.kind = "data-contract" with mappings for category and value.",
        ],
        "type": "chart-bar",
        "usage": [
          "Use chart-bar for small report charts where categories compare numeric values.",
          "Use data-contract binding mappings: mappings.category selects the category source path and mappings.value selects the numeric value source path.",
          "The resolver derives whether mappings share a record collection or should be aligned by index.",
          "Chart-bar projects ordinary business fields into chart points.",
          "Designer preview uses built-in sample data only.",
          "Use showXAxisLabel/showYAxisLabel and showXAxisLine/showYAxisLine to hide axis labels or axis lines when a compact chart is needed.",
        ],
      },
      "binding": {
        "contract": {
          "model": {
            "fields": {
              "category": {
                "format": "display",
                "labelKey": "materials.chartBar.data.category",
                "required": true,
                "type": "string",
              },
              "value": {
                "format": "raw",
                "labelKey": "materials.chartBar.data.value",
                "required": true,
                "type": "number",
              },
            },
            "kind": "tabular",
          },
          "version": 3,
        },
        "formatEditor": {
          "defaultTab": "custom",
          "tabs": [
            "custom",
          ],
        },
        "kind": "data-contract",
      },
      "capabilities": {
        "bindable": true,
        "multiBinding": false,
